{
  "name": "neo-ecommerce-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && npm run db:bootstrap && next build",
    "deploy:prepare": "prisma migrate deploy && npm run db:bootstrap",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test tests/*.test.ts",
    "manifest:validate": "node scripts/validate-template-manifest.mjs",
    "db:push": "prisma db push",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:seed": "npm run db:bootstrap",
    "db:reset-demo": "tsx prisma/reset-demo.ts",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx scripts/db-bootstrap.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.5.0",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "^2.36.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "next": "^14.2.35",
    "next-auth": "5.0.0-beta.19",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "resend": "^6.9.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "4.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.10",
    "prisma": "6.5.0",
    "tailwindcss": "3.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "5.4.5"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "glob": "^11.0.0"
  }
}
