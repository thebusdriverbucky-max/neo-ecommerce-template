# REQUIRED — license values supplied with your purchase
LICENSE_KEY=
LICENSE_SERVER_URL=
LICENSE_SERVER_SECRET=
LICENSE_PRODUCT=

# REQUIRED — PostgreSQL
# Lite uses one provider-supported connection for runtime and migrations.
DATABASE_URL=

# REQUIRED — application origin and authentication
# Use the same deployed HTTPS origin for NEXTAUTH_URL and NEXT_PUBLIC_APP_URL.
NEXTAUTH_URL=https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXTAUTH_SECRET=

# REQUIRED — administrator identity and signed guest order links
# Register/sign in with this exact address to receive administrator access.
# ADMIN_EMAIL is also the fallback recipient for order, contact-form and
# low-stock emails when no store email is set in Admin -> Settings.
ADMIN_EMAIL=owner@yourdomain.com
# Independent random secret, at least 32 characters. NEXTAUTH_SECRET is NOT a
# fallback: without this value guest checkout and guest order links are disabled.
GUEST_ORDER_TOKEN_SECRET=

# OPTIONAL — email delivery for password recovery and notifications
# Configure both values together. Without RESEND_API_KEY no email is sent (a
# warning is logged). The default sender onboarding@resend.dev can only deliver
# to your own Resend account, so verify a domain and set EMAIL_FROM before launch.
RESEND_API_KEY=
EMAIL_FROM=Your Store <noreply@yourdomain.com>

# OPTIONAL — temporary URL compatibility aliases
# Use the same value as NEXT_PUBLIC_APP_URL. The marketplace ENV Builder fills
# these automatically from one site-address field.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_STORE_URL=https://yourdomain.com

# OPTIONAL — Google sign-in; configure both values together
GOOGLE_ID=
GOOGLE_SECRET=

# OPTIONAL — built-in Cloudinary image uploader; configure both values together
# Without these values, admins can still paste hosted image URLs manually.
# Use an image-only unsigned upload preset. No Cloudinary API secret is used in
# this browser-widget architecture.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# OPTIONAL — distributed Upstash rate limiting; configure both or neither
# The application uses its documented bounded local fallback when omitted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Store name, support email and currency are managed in Admin -> Settings.
# Support address shown on the license-required page.
NEXT_PUBLIC_SUPPORT_EMAIL=
# OPTIONAL — analytics
NEXT_PUBLIC_GA_ID=
