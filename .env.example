# Next.js & Auth
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXTAUTH_SECRET=
GUEST_ORDER_TOKEN_SECRET=
ADMIN_EMAIL=your@email.com

# License (provided after purchase)
LICENSE_KEY=
LICENSE_SERVER_URL=https://license-server-phi-eight.vercel.app
LICENSE_SERVER_SECRET=
LICENSE_PRODUCT=neo-ecommerce-full

# Database
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Stripe (required for card checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stable, unique identifier for this site when a Stripe account serves multiple deployments.
STRIPE_DEPLOYMENT_ID=store-yourdomain-com

# Google OAuth (optional; credentials login remains available without it)
GOOGLE_ID=
GOOGLE_SECRET=

# OPTIONAL — built-in Cloudinary image uploader; configure both values together
# Without these values, admins can still paste hosted image URLs manually.
# Use an image-only unsigned preset. No Cloudinary API secret is used by this widget.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# OPTIONAL — transactional email; configure both values together
RESEND_API_KEY=
EMAIL_FROM=

# Optional presentation/analytics fallbacks. Store settings in the CMS take
# precedence where available.
NEXT_PUBLIC_STORE_NAME=
NEXT_PUBLIC_STORE_URL=
STORE_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_CURRENCY_SYMBOL=
NEXT_PUBLIC_GA_ID=

# OPTIONAL — distributed application rate limits (Upstash); configure both or neither
# Leave both empty when using the required external limiter described in RATE_LIMITING.md.
# Empty values never initialize an Upstash provider client.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron / Stripe reconciliation (required by the included cron)
CRON_SECRET=
